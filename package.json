{
  "name": "capsule-toys",
  "version": "2.0.0",
  "private": true,
  "description": "A capsule toy machine for augmented reality: turn the knob, and a random model opens in AR Quick Look on your iPhone.",
  "type": "module",
  "license": "MIT",
  "author": "Aleksei Volkov",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "check": "tsc",
    "models": ".venv/bin/python models/build.py",
    "check-models": ".venv/bin/python models/check.py",
    "prebuild": "sh scripts/fetch-fonts.sh",
    "build": "vite build"
  },
  "dependencies": {
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
